{
  "type": "object",
  "properties": {
    "ModuleTitle": {
      "type": "string",
      "title": "Module Title"
    },
    "Type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Unordered",
        "Unstyled",
        "Description",
        "Icons"
      ],
      "default": "Unordered"
    },
    "Items": {
      "type": "array",
      "title": "Items (for Unordered, Unstyled, or Icons)",
      "items": {
        "type": "object",
        "properties": {
          "ListItemText": {
            "type": "string",
            "title": "List Item Text (required)",
            "required": true
          },
          "Icon": {
            "type": "string",
            "title": "Icon (optional)"
          },
          "SecondLevelItems": {
            "type": "array",
            "title": "Second Level List Item",
            "items": {
              "type": "object",
              "properties": {
                "SecondLevelListItemText": {
                  "type": "string",
                  "title": "Second Level List Item Text (Requerido)"
                },
                "SecondLevelListItemIcon": {
                  "type": "string",
                  "title": "Second Level Icon (optional)"
                }
              }
            }
          }
        }
      }
    },
    "ItemsDescription": {
      "type": "array",
      "title": "Items (for Description type)",
      "dependencies": [
        "Type"
      ],
      "items": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "title": "Title"
          },
          "ListItemText": {
            "type": "string",
            "title": "List Item Text",
            "required": true
          }
        }
      }
    }
  }
}